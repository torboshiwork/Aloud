<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ไมโครโฟนใต้ hardened runtime -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- ถอดออกแล้ว: disable-library-validation (มีไว้ให้ Sparkle โหลด framework — ไม่มี Sparkle แล้ว)
         และ automation.apple-events (แอป paste ด้วย CGEvent + NSPasteboard ไม่ใช่ Apple Events) -->
</dict>
</plist>
